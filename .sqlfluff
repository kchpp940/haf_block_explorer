[sqlfluff]
dialect = postgres
templater = raw
rules = all
exclude_rules = L003, L009, L011, L016, L017, L019, L029, L031, L034, L035, L040, L042, L044, L045, L046, L048, L050, L051, L052, L054, L057, L059, L062, L063, L064, L065, L066, L067, L068, L071, L073, L074, L075, L077, L079, L080, L081, L082, L083, L084, L085, L086, L087, L088, L089, L090, L092, L093, L094, L095, L096, L097, L098, L099, L100, L101, L102, L103, L104, L105, L106, L107, L108

[sqlfluff:rules]
tab_space_size = 4
max_line_length = 170
indent_unit = 4
comma_style = trailing
allow_scalar = True
single_table_references = consistent
unquoted_identifiers_policy = all

[sqlfluff:rules:L010]
capitalisation_policy = lower

[sqlfluff:rules:L030]
capitalisation_policy = lower

[sqlfluff:rules:L040]
capitalisation_policy = lower

[sqlfluff:indentation]
indented_joins = False
indented_using_on = True
template_blocks_indent = True

[sqlfluff:templater:raw]
